{
  "name": "123",
  "compatibility_date": "2026-08-09",
  "main": "src/worker.js",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SUPABASE_URL": "https://ievwycehuzhurxkcczra.supabase.co",
    // QuickBooks: "sandbox" while using Intuit development keys; "production" once Intuit issues live keys
    "QBO_ENV": "production",
    // Invoices per QuickBooks sync step. Each invoice costs ~5 database calls.
    // Workers Paid plan (1,000 outbound calls per invocation): 15 per step.
    // On the free plan (50 calls) this must come back down to 3.
    "QBO_PAGE_SIZE": "15",
    // Self-calls the every-minute sync sweep may make per firing (one per
    // company per round). Paid plan: 400; free plan: 45.
    "QBO_SWEEP_BUDGET": "400"
  },
  "triggers": {
    // Every minute: QuickBooks / IES change pulls and first imports (each
    // company's step runs in its own invocation; only the cron handler may
    // call this Worker's own URL, so this trigger is what drives imports).
    // Every 5 minutes: inbound-reply sweep; the hourly jobs (cadence,
    // reports) run on the first firing of each hour.
    "crons": [
      "* * * * *",
      "*/5 * * * *"
    ]
  },
  "assets": {
    "directory": "./",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
